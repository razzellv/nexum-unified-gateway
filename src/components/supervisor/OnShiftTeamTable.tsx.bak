import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Users, Clock, Activity, Award } from 'lucide-react';
import { cn } from '@/lib/utils';

interface OnShiftTeamMember {
  employee: string | { name: string; id: string };
  operatorId: string;
  role: string;
  systems_logged_24h: number;
  total_logs: number;
  specialty: string;
  last_activity?: string;
  violations_count?: number;
  compliance_rate?: number;
  virtuous_score?: number;
}

interface OnShiftTeamTableProps {
  team: OnShiftTeamMember[];
}

// Safe string extraction
const safeString = (value: any, fallback: string = 'Unknown'): string => {
  if (!value) return fallback;
  if (typeof value === 'string') return value;
  if (typeof value === 'object' && value.name) return value.name;
  if (typeof value === 'object' && value.id) return value.id;
  return String(value);
};

export function OnShiftTeamTable({ team }: OnShiftTeamTableProps) {
  return (
    <Card className="neon-border bg-card/80">
      <CardHeader>
        <CardTitle className="flex items-center gap-2">
          <Users className="h-5 w-5 text-primary" />
          On-Shift Team Activity
          <Badge variant="outline" className="ml-auto">{team.length} Active</Badge>
        </CardTitle>
      </CardHeader>
      <CardContent>
        {team.length === 0 ? (
          <div className="text-center py-12 text-muted-foreground">
            <Users className="h-12 w-12 mx-auto mb-4 opacity-50" />
            <p>No on-shift team members</p>
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full">
              <thead>
                <tr className="border-b border-border/50">
                  <th className="text-left p-3 text-sm font-semibold">Employee</th>
                  <th className="text-left p-3 text-sm font-semibold">Role</th>
                  <th className="text-center p-3 text-sm font-semibold">Systems</th>
                  <th className="text-center p-3 text-sm font-semibold">Logs</th>
                  <th className="text-center p-3 text-sm font-semibold">Violations</th>
                  <th className="text-center p-3 text-sm font-semibold">Compliance</th>
                  <th className="text-center p-3 text-sm font-semibold">Virtuous</th>
                </tr>
              </thead>
              <tbody>
                {team.map((member, idx) => (
                  <tr key={`${member.operatorId}-${idx}`} className="border-b border-border/30 hover:bg-accent/50 neon-glow-row">
                    <td className="p-3">
                      <div className="flex flex-col">
                        <span className="font-medium">{safeString(member.employee, member.operatorId)}</span>
                        <span className="text-xs text-muted-foreground">{member.operatorId}</span>
                      </div>
                    </td>
                    <td className="p-3">
                      <Badge variant="outline">{member.role}</Badge>
                    </td>
                    <td className="p-3 text-center">
                      <span className="font-bold text-primary">{member.systems_logged_24h}</span>
                    </td>
                    <td className="p-3 text-center">
                      <span className="font-semibold">{member.total_logs}</span>
                    </td>
                    <td className="p-3 text-center">
                      <Badge variant={(member.violations_count || 0) > 0 ? 'destructive' : 'secondary'}>
                        {member.violations_count || 0}
                      </Badge>
                    </td>
                    <td className="p-3 text-center">
                      <span className={cn('font-bold', 
                        (member.compliance_rate || 100) >= 90 ? 'text-green-500' :
                        (member.compliance_rate || 100) >= 75 ? 'text-yellow-500' : 'text-destructive'
                      )}>
                        {member.compliance_rate || 100}%
                      </span>
                    </td>
                    <td className="p-3 text-center">
                      <span className={cn('font-bold',
                        (member.virtuous_score || 100) >= 80 ? 'text-green-500' :
                        (member.virtuous_score || 100) >= 60 ? 'text-yellow-500' : 'text-destructive'
                      )}>
                        {member.virtuous_score || 100}%
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </CardContent>
    </Card>
  );
}
